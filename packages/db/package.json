{
  "name": "@glitch/db",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "reset": "prisma migrate reset --force --skip-seed",
    "seed:demo": "tsx src/seed.ts --demo",
    "build": "tsc",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glitch/connectors": "workspace:*",
    "@glitch/content-engine": "workspace:*",
    "@glitch/core": "workspace:*",
    "@glitch/crawler": "workspace:*",
    "@glitch/log-parser": "workspace:*",
    "@glitch/schema-engine": "workspace:*",
    "@glitch/testing": "workspace:*",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.0.0",
    "nodemailer": "6.9.16"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "6.4.17",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
