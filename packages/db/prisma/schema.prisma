datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  SEO_MANAGER
  EDITOR
  VIEWER
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
}

enum PageStatus {
  BLOCKED
  NEEDS_REVIEW
  READY_FOR_APPROVAL
  APPROVED
  PUBLISHED
  SENT_AS_DRAFT
  FAILED
  ARCHIVED
}

model User {
  id                 String            @id @default(uuid())
  username           String            @unique
  email              String?           @unique
  name               String
  passwordHash       String            // bcrypt
  avatarUrl          String?
  mustChangePassword Boolean           @default(false)
  disabled           Boolean           @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  memberships        WorkspaceMember[]
  auditEvents        AuditEvent[]
  approvals          Approval[]
  sessions           Session[]
}

/// Server-side session. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  sites       Site[]
  auditEvents AuditEvent[]
  googleAccount GoogleAccount?
  aiKeys        AiProviderKey[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  role        Role      @default(VIEWER)
  workspaceId String
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model Site {
  id                 String           @id @default(uuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  domain             String
  canonicalUrl       String
  environment        String           @default("production") // production, staging, development
  language           String           @default("en")
  targetCountry      String           @default("US")
  timezone           String           @default("UTC")
  cms                String           @default("wordpress")
  sitemapUrl         String?
  robotsUrl          String?
  logFormat          String           @default("nginx_combined")
  maxRps             Float            @default(5.0)
  userAgent          String           @default("GlitchSeoOpsBot/1.0")
  status             String           @default("active")
  isVerified         Boolean          @default(false)
  lastAuditAt        DateTime?
  lastLogImportAt    DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  logImports         LogImport[]
  sitemapUrls        SitemapUrl[]
  alerts             Alert[]
  generatedPages     GeneratedPage[]
  datasets           Dataset[]
  jobs               Job[]
  performanceRuns    PerformanceRun[]
  seoChanges         SeoChangeProposal[]
  crawlSchedule      String?   // cron expression in the site's timezone, null = off
  crawlScheduleOptions Json?
  crawls             CrawlRun[]
  issues             Issue[]
  wpConnection       WordPressConnection?
  gscProperty        String?
  gscImports         GscImport[]
  monitor            SiteMonitor?
  aiPrompts          AiPrompt[]
  aiObservations     AiObservation[]
  aiAnalyses         AiAnalysis[]
  geoPrompts         GeoPrompt[]
}

model LogImport {
  id              String        @id @default(uuid())
  siteId          String
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fileName        String
  checksum        String
  status          String        @default("completed") // pending, processing, completed, failed
  totalLines      Int           @default(0)
  validLines      Int           @default(0)
  invalidLines    Int           @default(0)
  skippedLines    Int           @default(0)
  fileSizeBytes   BigInt        @default(0)
  startDate       DateTime?
  endDate         DateTime?
  crawledPagesCount Int         @default(0)
  googlebotRequests Int         @default(0)
  aiBotRequests     Int         @default(0)
  errorsSummary   Json?
  stats           Json?         // percentiles, AI bot breakdown, parameter stats
  createdAt       DateTime      @default(now())
  aggregates      LogAggregate[]

  @@unique([siteId, checksum])
}

model LogAggregate {
  id            String    @id @default(uuid())
  logImportId   String
  logImport     LogImport @relation(fields: [logImportId], references: [id], onDelete: Cascade)
  date          DateTime
  botName       String
  botCategory   String
  statusCode    Int
  path          String
  hits          Int       @default(1)
  bytes         BigInt    @default(0)
  avgDurationMs Float     @default(0)
  durationSamples Int     @default(0) // lines that included $request_time

  @@index([logImportId, botName])
  @@index([logImportId, path])
}

model SitemapUrl {
  id        String    @id @default(uuid())
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  path      String
  lastmod   DateTime?
  source    String    // sitemap URL or uploaded file name
  createdAt DateTime  @default(now())

  @@unique([siteId, path])
}

model CrawlRun {
  id             String        @id @default(uuid())
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status         String        @default("running") // running, completed, failed, cancelled
  /// site = follows links from the start URL; list = only the given URLs (never a baseline for diffs, issues or alerts)
  mode           String        @default("site")
  urlsCrawled    Int           @default(0)
  urlsDiscovered Int           @default(0)
  issuesFound    Int           @default(0)
  maxDepth       Int           @default(3)
  config         Json?
  error          String?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  /// Set when the heavy detail (HTML, link list, resources) was removed to save disk; page summaries stay.
  detailPurgedAt DateTime?
  pages          CrawledPage[]
  links          CrawledLink[]
  resources      CrawledResource[]
  issues         Issue[]
  alerts         Alert[]
}

model CrawledPage {
  id                 String    @id @default(uuid())
  crawlRunId         String
  crawlRun           CrawlRun  @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  url                String
  finalUrl           String
  statusCode         Int       // 0 = not fetched (blocked or network error)
  responseTimeMs     Int
  mimeType           String    @default("text/html")
  sizeBytes          Int       @default(0)
  title              String?
  metaDescription    String?
  canonical          String?
  robotsMeta         String?
  xRobotsTag         String?
  h1                 String?
  h1Count            Int       @default(0)
  lang               String?
  hreflang           Json?
  schemaTypes        Json?
  schemaErrors       Int       @default(0)
  redirectChain      Json?
  contentHash        String?
  inlinks            Int       @default(0)
  outlinks           Int       @default(0)
  externalLinks      Int       @default(0)
  imagesMissingAlt   Int       @default(0)
  blockedByRobots    Boolean   @default(false)
  error              String?
  inSitemap          Boolean   @default(false)
  inLogs             Boolean   @default(false)
  isIndexable        Boolean   @default(true)
  indexabilityReason String?
  wordCount          Int       @default(0)
  depth              Int       @default(0)
  // Explorer (Screaming Frog-style) details
  titleCount         Int       @default(0)
  metaDescriptionCount Int     @default(0)
  h1All              Json?
  h2                 Json?
  metaKeywords       String?
  og                 Json?
  twitter            Json?
  relNext            String?
  relPrev            String?
  images             Json?     // [{ src, alt, width, height, loading }] (max 200)
  headers            Json?
  htmlGz             Bytes?    // gzip of the HTML (max 2 MB raw; the rendered DOM when JavaScript was executed)
  js                 Json?     // what JavaScript changed (only when the crawl rendered JS)
  createdAt          DateTime  @default(now())

  @@index([crawlRunId, statusCode])
}

/// One <a href> found on a crawled page (max 500 per page).
model CrawledLink {
  id         String   @id @default(uuid())
  crawlRunId String
  crawlRun   CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  sourceUrl  String
  targetUrl  String
  anchor     String
  internal   Boolean
  nofollow   Boolean  @default(false)

  @@index([crawlRunId, targetUrl])
  @@index([crawlRunId, sourceUrl])
}

/// A file used by crawled pages (CSS, JS, image, font, PDF…) or an external link, with its HTTP check.
model CrawledResource {
  id             String   @id @default(uuid())
  crawlRunId     String
  crawlRun       CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  url            String
  kind           String
  internal       Boolean
  isLink         Boolean
  statusCode     Int
  finalUrl       String
  redirected     Boolean
  contentType    String
  sizeBytes      Int?
  responseTimeMs Int
  error          String?
  foundOn        Json
  foundOnCount   Int

  @@index([crawlRunId, kind])
}

model Issue {
  id                String       @id @default(uuid())
  siteId            String
  site              Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlRunId        String?
  crawlRun          CrawlRun?    @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  code              String
  category          String
  title             String
  description       String
  severity          Severity     @default(MEDIUM)
  impact            Int          @default(5)
  effort            Int          @default(3)
  risk              Int          @default(2)
  confidence        Float        @default(0.9)
  priorityScore     Float        @default(5.0)
  affectedUrlsCount Int          @default(1)
  affectedUrls      Json?        // sample of affected URLs (max 200)
  evidence          Json?
  recommendation    String
  status            String       @default("open") // open, in_progress, resolved, ignored
  createdAt         DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())
  resolvedAt        DateTime?

  @@unique([siteId, code])
}

model Dataset {
  id          String          @id @default(uuid())
  siteId      String?
  site        Site?           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String
  filename    String
  checksum    String
  rowCount    Int             @default(0)
  columns     Json            // [{ name, type, empty, unique }]
  data        Json            // array of row objects (max 5,000 rows)
  issues      Json?           // duplicate rows, empty cells, duplicate keys
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  templates   ContentTemplate[]

  @@unique([siteId, checksum])
}

model ContentTemplate {
  id            String          @id @default(uuid())
  datasetId     String
  dataset       Dataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name          String
  titleTemplate String
  descTemplate  String
  bodyTemplate  String
  slugTemplate  String
  schemaType    String          @default("Article")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  generatedPages GeneratedPage[]
}

model GeneratedPage {
  id                String       @id @default(uuid())
  siteId            String?
  site              Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  templateId        String?
  template          ContentTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  slug              String
  title             String
  metaDescription   String
  content           String
  sourceData        Json?        // the data row the page was rendered from (provenance)
  sourceRow         Int?         // row index in the dataset
  uniqueWords       Int          @default(0) // words not shared with the template boilerplate
  schemaJson        Json?
  status            PageStatus   @default(NEEDS_REVIEW)
  similarityScore   Float        @default(0.0)
  qualityChecks     Json?
  publishedWpPostId Int?         // remote WordPress post id once a draft exists
  wpModifiedGmt     String?      // remote modified_gmt after our last write (conflict detection)
  wpLink            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  approvals         Approval[]
  publications      WordPressPublication[]
}

model Approval {
  id              String        @id @default(uuid())
  generatedPageId String
  generatedPage   GeneratedPage @relation(fields: [generatedPageId], references: [id], onDelete: Cascade)
  userId          String?       // null until authentication exists
  user            User?         @relation(fields: [userId], references: [id])
  reviewer        String        // display name entered by the reviewer
  action          String        // approved, rejected
  notes           String?
  createdAt       DateTime      @default(now())
}

model WordPressConnection {
  id             String    @id @default(uuid())
  siteId         String    @unique
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  endpointUrl    String    // site root, e.g. https://example.com
  username       String
  appPasswordEnc String    // AES-256-GCM, key from CREDENTIALS_KEY
  status         String    @default("untested") // untested, ok, error
  remoteName     String?
  lastTestAt     DateTime?
  lastError      String?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publications   WordPressPublication[]
}

/// Every attempt to send a page to WordPress, including dry runs and refusals.
model WordPressPublication {
  id              String              @id @default(uuid())
  generatedPageId String
  generatedPage   GeneratedPage       @relation(fields: [generatedPageId], references: [id], onDelete: Cascade)
  connectionId    String?
  connection      WordPressConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  action          String              // dry_run, create, update
  result          String              // success, failed, conflict, refused
  wpPostId        Int?
  wpLink          String?
  contentHash     String
  diff            Json?
  previousRemote  Json?               // backup of the remote post before an update
  error           String?
  createdAt       DateTime            @default(now())
}

/// One Google account per workspace, connected with OAuth (read-only Search Console).
model GoogleAccount {
  id              String    @id @default(uuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String?
  refreshTokenEnc String // AES-256-GCM (CREDENTIALS_KEY)
  scope           String
  connectedById   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// One import of Search Analytics for a site (a date window); the newest completed one is reported.
model GscImport {
  id          String         @id @default(uuid())
  siteId      String
  site        Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  property    String
  startDate   String
  endDate     String
  status      String         @default("running") // running, completed, failed
  error       String?
  pageRows    Int            @default(0)
  queryRows   Int            @default(0)
  truncated   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  pages       GscPageStat[]
  queries     GscQueryStat[]
  days        GscDailyStat[]

  @@index([siteId, createdAt])
}

model GscPageStat {
  id          String    @id @default(uuid())
  importId    String
  import      GscImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  page        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  @@index([importId, page])
}

model GscQueryStat {
  id          String    @id @default(uuid())
  importId    String
  import      GscImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  query       String
  page        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  @@index([importId])
}

model GscDailyStat {
  id          String    @id @default(uuid())
  importId    String
  import      GscImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  date        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  @@index([importId, date])
}

model GeoPrompt {
  id           String           @id @default(uuid())
  siteId       String
  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  prompt       String
  entity       String
  brand        String
  market       String           @default("US")
  createdAt    DateTime         @default(now())
  observations GeoObservation[]
}

model GeoObservation {
  id             String    @id @default(uuid())
  geoPromptId    String
  geoPrompt      GeoPrompt @relation(fields: [geoPromptId], references: [id], onDelete: Cascade)
  modelName      String    @default("gpt-4o")
  brandMentioned Boolean   @default(false)
  positionInText Int?
  citations      Json?
  sentiment      String    @default("neutral")
  responseSample String
  observedAt     DateTime  @default(now())
}

/// Durable record of every background job. BullMQ (Redis) runs it; this table keeps the history.
model Job {
  id              String     @id @default(uuid())
  type            String     // log-import, crawl, retention
  queue           String
  status          JobStatus  @default(QUEUED)
  siteId          String?
  site            Site?      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workspaceId     String?
  createdById     String?
  trigger         String     @default("manual") // manual, schedule, system
  idempotencyKey  String?    @unique
  progress        Int        @default(0) // 0-100 when known
  progressDetail  Json?
  payload         Json?
  result          Json?
  error           String?
  logs            Json?      // last lines: [{ at, level, msg }]
  attempts        Int        @default(0)
  maxAttempts     Int        @default(1)
  cancelRequested Boolean    @default(false)
  retryOfId       String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([siteId, createdAt])
  @@index([status])
}

model AuditEvent {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime   @default(now())
}

/// Raised when something important changes between two crawls of the same site.
model Alert {
  id             String    @id @default(uuid())
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlRunId     String?
  crawlRun       CrawlRun? @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  type           String    // e.g. NOINDEX_ADDED, CANONICAL_CHANGED, PAGE_BROKEN
  severity       Severity  @default(MEDIUM)
  message        String
  urls           Json?
  details        Json?
  status         String    @default("open") // open, acknowledged
  deliveredTo    Json?     // channels that received it, with result
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([siteId, status])
}

/// Cache of crawler DNS verification. Keyed by family + HMAC of the IP: no raw IP or hostname is stored.
model BotIpVerification {
  key       String   @id // `${family}:${hmac(ip)}`
  family    String
  result    String   // verified | spoofed
  checkedAt DateTime @default(now())
}

/// One measurement of one URL. Lab (Lighthouse) and field (CrUX) data are kept apart on purpose.
model PerformanceRun {
  id               String   @id @default(uuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  jobId            String?
  url              String
  finalUrl         String?
  strategy         String   // mobile | desktop
  source           String   // lighthouse-local | psi
  status           String   // ok | failed
  error            String?
  performanceScore Int?
  labLcp           Float?
  labCls           Float?
  labTbt           Float?
  lab              Json?
  fieldStatus      String   @default("not-requested") // available | insufficient-data | not-requested
  fieldScope       String?  // url | origin
  fieldLcp         Float?
  fieldInp         Float?
  fieldCls         Float?
  field            Json?
  diagnostics      Json?
  resources        Json?
  /// GTmetrix-style detail (screenshot, filmstrip, grade, issues, weight by type, waterfall). Kept for the last 5 runs per URL and strategy.
  report           Json?
  lighthouseVersion String?
  createdAt        DateTime @default(now())

  @@index([siteId, url, createdAt])
}

/// A proposed change to an SEO field of live WordPress content. Applied only after approval.
model SeoChangeProposal {
  id           String    @id @default(uuid())
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url          String    // page where the field was seen
  target       String    // post | page | media
  wpId         Int
  field        String    // postTitle | slug | seoTitle | metaDescription | imageAlt
  metaKey      String?   // Yoast / Rank Math key for seoTitle and metaDescription
  imageSrc     String?
  oldValue     String    // value in WordPress when proposed (also the backup used to revert)
  newValue     String
  note         String?
  status       String    @default("proposed") // proposed, approved, rejected, applied, conflict, failed, reverted
  verifyStatus String?   // verified | mismatch | error
  verifyDetail String?
  error        String?
  createdById  String?
  reviewedById String?
  appliedById  String?
  appliedAt    DateTime?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([siteId, status])
}

/// "Monitoreo": what runs automatically for a site. Everything is off until the user turns it on.
/// The crawl part lives in Site.crawlSchedule (shared with the crawl section).
model SiteMonitor {
  id               String   @id @default(uuid())
  siteId           String   @unique
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  gscEnabled       Boolean  @default(false)
  vitalsEnabled    Boolean  @default(false)
  vitalsCron       String   @default("0 5 * * 1")
  /// top = the pages with most Search Console clicks (falls back to the most linked pages); manual = vitalsUrls
  vitalsUrlMode    String   @default("top")
  vitalsUrls       Json?
  vitalsCount      Int      @default(5)
  vitalsStrategies Json?
  updatedAt        DateTime @updatedAt
}

/// API keys for AI providers (stored encrypted; managed by Admins in "Configuración").
model AiProviderKey {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String // anthropic, openai, google, serpapi
  keyEnc      String // AES-256-GCM (CREDENTIALS_KEY)
  keyHint     String // last 4 characters, to recognise the key
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, provider])
}

/// A long-tail question or compound phrase tracked in AI answers, with its keyword group (e.g. "Políticas Públicas").
model AiPrompt {
  id           String          @id @default(uuid())
  siteId       String
  site         Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  text         String
  keyword      String
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  observations AiObservation[]

  @@index([siteId, keyword])
}

/// One check of one question in one AI engine on one date: a "Directo" row (brand mentioned) and a "Citación" row (site cited).
model AiObservation {
  id             String   @id @default(uuid())
  promptId       String
  prompt         AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  engine         String // chatgpt, claude, gemini, google_ai
  date           String // YYYY-MM-DD
  source         String   @default("manual") // manual | api
  mentioned      Boolean  @default(false)
  mentionPos     Int? // 1 = first place, 3 = top 3, 4 = 4th or lower
  mentionText    String?
  mentionComment String?
  cited          Boolean  @default(false)
  citePos        Int?
  citeText       String?
  citeComment    String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([promptId, engine, date])
  @@index([siteId, date])
}

/// AI-written analysis of the visibility data (kept for history).
model AiAnalysis {
  id          String   @id @default(uuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  provider    String
  model       String
  text        String
  createdById String?
  createdAt   DateTime @default(now())
}
