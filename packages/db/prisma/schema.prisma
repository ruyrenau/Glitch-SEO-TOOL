datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  SEO_MANAGER
  EDITOR
  VIEWER
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
}

enum PageStatus {
  BLOCKED
  NEEDS_REVIEW
  READY_FOR_APPROVAL
  APPROVED
  PUBLISHED
  SENT_AS_DRAFT
  FAILED
  ARCHIVED
}

model User {
  id                 String            @id @default(uuid())
  username           String            @unique
  email              String?           @unique
  name               String
  passwordHash       String            // bcrypt
  avatarUrl          String?
  mustChangePassword Boolean           @default(false)
  disabled           Boolean           @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  memberships        WorkspaceMember[]
  auditEvents        AuditEvent[]
  approvals          Approval[]
  sessions           Session[]
}

/// Server-side session. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  sites       Site[]
  auditEvents AuditEvent[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  role        Role      @default(VIEWER)
  workspaceId String
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model Site {
  id                 String           @id @default(uuid())
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  domain             String
  canonicalUrl       String
  environment        String           @default("production") // production, staging, development
  language           String           @default("en")
  targetCountry      String           @default("US")
  timezone           String           @default("UTC")
  cms                String           @default("wordpress")
  sitemapUrl         String?
  robotsUrl          String?
  logFormat          String           @default("nginx_combined")
  maxRps             Float            @default(5.0)
  userAgent          String           @default("GlitchSeoOpsBot/1.0")
  status             String           @default("active")
  isVerified         Boolean          @default(false)
  lastAuditAt        DateTime?
  lastLogImportAt    DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  logImports         LogImport[]
  sitemapUrls        SitemapUrl[]
  alerts             Alert[]
  generatedPages     GeneratedPage[]
  datasets           Dataset[]
  jobs               Job[]
  crawlSchedule      String?   // cron expression in the site's timezone, null = off
  crawlScheduleOptions Json?
  crawls             CrawlRun[]
  issues             Issue[]
  wpConnection       WordPressConnection?
  gscConnections     SearchConsoleConnection[]
  geoPrompts         GeoPrompt[]
}

model LogImport {
  id              String        @id @default(uuid())
  siteId          String
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fileName        String
  checksum        String
  status          String        @default("completed") // pending, processing, completed, failed
  totalLines      Int           @default(0)
  validLines      Int           @default(0)
  invalidLines    Int           @default(0)
  skippedLines    Int           @default(0)
  fileSizeBytes   BigInt        @default(0)
  startDate       DateTime?
  endDate         DateTime?
  crawledPagesCount Int         @default(0)
  googlebotRequests Int         @default(0)
  aiBotRequests     Int         @default(0)
  errorsSummary   Json?
  stats           Json?         // percentiles, AI bot breakdown, parameter stats
  createdAt       DateTime      @default(now())
  aggregates      LogAggregate[]

  @@unique([siteId, checksum])
}

model LogAggregate {
  id            String    @id @default(uuid())
  logImportId   String
  logImport     LogImport @relation(fields: [logImportId], references: [id], onDelete: Cascade)
  date          DateTime
  botName       String
  botCategory   String
  statusCode    Int
  path          String
  hits          Int       @default(1)
  bytes         BigInt    @default(0)
  avgDurationMs Float     @default(0)
  durationSamples Int     @default(0) // lines that included $request_time

  @@index([logImportId, botName])
  @@index([logImportId, path])
}

model SitemapUrl {
  id        String    @id @default(uuid())
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  path      String
  lastmod   DateTime?
  source    String    // sitemap URL or uploaded file name
  createdAt DateTime  @default(now())

  @@unique([siteId, path])
}

model CrawlRun {
  id             String        @id @default(uuid())
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status         String        @default("running") // running, completed, failed, cancelled
  urlsCrawled    Int           @default(0)
  urlsDiscovered Int           @default(0)
  issuesFound    Int           @default(0)
  maxDepth       Int           @default(3)
  config         Json?
  error          String?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  pages          CrawledPage[]
  issues         Issue[]
  alerts         Alert[]
}

model CrawledPage {
  id                 String    @id @default(uuid())
  crawlRunId         String
  crawlRun           CrawlRun  @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  url                String
  finalUrl           String
  statusCode         Int       // 0 = not fetched (blocked or network error)
  responseTimeMs     Int
  mimeType           String    @default("text/html")
  sizeBytes          Int       @default(0)
  title              String?
  metaDescription    String?
  canonical          String?
  robotsMeta         String?
  xRobotsTag         String?
  h1                 String?
  h1Count            Int       @default(0)
  lang               String?
  hreflang           Json?
  schemaTypes        Json?
  schemaErrors       Int       @default(0)
  redirectChain      Json?
  contentHash        String?
  inlinks            Int       @default(0)
  outlinks           Int       @default(0)
  externalLinks      Int       @default(0)
  imagesMissingAlt   Int       @default(0)
  blockedByRobots    Boolean   @default(false)
  error              String?
  inSitemap          Boolean   @default(false)
  inLogs             Boolean   @default(false)
  isIndexable        Boolean   @default(true)
  indexabilityReason String?
  wordCount          Int       @default(0)
  depth              Int       @default(0)
  createdAt          DateTime  @default(now())

  @@index([crawlRunId, statusCode])
}

model Issue {
  id                String       @id @default(uuid())
  siteId            String
  site              Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlRunId        String?
  crawlRun          CrawlRun?    @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  code              String
  category          String
  title             String
  description       String
  severity          Severity     @default(MEDIUM)
  impact            Int          @default(5)
  effort            Int          @default(3)
  risk              Int          @default(2)
  confidence        Float        @default(0.9)
  priorityScore     Float        @default(5.0)
  affectedUrlsCount Int          @default(1)
  affectedUrls      Json?        // sample of affected URLs (max 200)
  evidence          Json?
  recommendation    String
  status            String       @default("open") // open, in_progress, resolved, ignored
  createdAt         DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())
  resolvedAt        DateTime?

  @@unique([siteId, code])
}

model Dataset {
  id          String          @id @default(uuid())
  siteId      String?
  site        Site?           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String
  filename    String
  checksum    String
  rowCount    Int             @default(0)
  columns     Json            // [{ name, type, empty, unique }]
  data        Json            // array of row objects (max 5,000 rows)
  issues      Json?           // duplicate rows, empty cells, duplicate keys
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  templates   ContentTemplate[]

  @@unique([siteId, checksum])
}

model ContentTemplate {
  id            String          @id @default(uuid())
  datasetId     String
  dataset       Dataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  name          String
  titleTemplate String
  descTemplate  String
  bodyTemplate  String
  slugTemplate  String
  schemaType    String          @default("Article")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  generatedPages GeneratedPage[]
}

model GeneratedPage {
  id                String       @id @default(uuid())
  siteId            String?
  site              Site?        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  templateId        String?
  template          ContentTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  slug              String
  title             String
  metaDescription   String
  content           String
  sourceData        Json?        // the data row the page was rendered from (provenance)
  sourceRow         Int?         // row index in the dataset
  uniqueWords       Int          @default(0) // words not shared with the template boilerplate
  schemaJson        Json?
  status            PageStatus   @default(NEEDS_REVIEW)
  similarityScore   Float        @default(0.0)
  qualityChecks     Json?
  publishedWpPostId Int?         // remote WordPress post id once a draft exists
  wpModifiedGmt     String?      // remote modified_gmt after our last write (conflict detection)
  wpLink            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  approvals         Approval[]
  publications      WordPressPublication[]
}

model Approval {
  id              String        @id @default(uuid())
  generatedPageId String
  generatedPage   GeneratedPage @relation(fields: [generatedPageId], references: [id], onDelete: Cascade)
  userId          String?       // null until authentication exists
  user            User?         @relation(fields: [userId], references: [id])
  reviewer        String        // display name entered by the reviewer
  action          String        // approved, rejected
  notes           String?
  createdAt       DateTime      @default(now())
}

model WordPressConnection {
  id             String    @id @default(uuid())
  siteId         String    @unique
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  endpointUrl    String    // site root, e.g. https://example.com
  username       String
  appPasswordEnc String    // AES-256-GCM, key from CREDENTIALS_KEY
  status         String    @default("untested") // untested, ok, error
  remoteName     String?
  lastTestAt     DateTime?
  lastError      String?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publications   WordPressPublication[]
}

/// Every attempt to send a page to WordPress, including dry runs and refusals.
model WordPressPublication {
  id              String              @id @default(uuid())
  generatedPageId String
  generatedPage   GeneratedPage       @relation(fields: [generatedPageId], references: [id], onDelete: Cascade)
  connectionId    String?
  connection      WordPressConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  action          String              // dry_run, create, update
  result          String              // success, failed, conflict, refused
  wpPostId        Int?
  wpLink          String?
  contentHash     String
  diff            Json?
  previousRemote  Json?               // backup of the remote post before an update
  error           String?
  createdAt       DateTime            @default(now())
}

model SearchConsoleConnection {
  id             String    @id @default(uuid())
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  propertyUrl    String
  refreshTokenEnc String?
  status         String    @default("connected")
  createdAt      DateTime  @default(now())
  metrics        SearchMetric[]
}

model SearchMetric {
  id           String                  @id @default(uuid())
  connectionId String
  connection   SearchConsoleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  date         DateTime
  query        String?
  page         String
  clicks       Int                     @default(0)
  impressions  Int                     @default(0)
  ctr          Float                   @default(0)
  position     Float                   @default(0)
}

model GeoPrompt {
  id           String           @id @default(uuid())
  siteId       String
  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  prompt       String
  entity       String
  brand        String
  market       String           @default("US")
  createdAt    DateTime         @default(now())
  observations GeoObservation[]
}

model GeoObservation {
  id             String    @id @default(uuid())
  geoPromptId    String
  geoPrompt      GeoPrompt @relation(fields: [geoPromptId], references: [id], onDelete: Cascade)
  modelName      String    @default("gpt-4o")
  brandMentioned Boolean   @default(false)
  positionInText Int?
  citations      Json?
  sentiment      String    @default("neutral")
  responseSample String
  observedAt     DateTime  @default(now())
}

/// Durable record of every background job. BullMQ (Redis) runs it; this table keeps the history.
model Job {
  id              String     @id @default(uuid())
  type            String     // log-import, crawl, retention
  queue           String
  status          JobStatus  @default(QUEUED)
  siteId          String?
  site            Site?      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workspaceId     String?
  createdById     String?
  trigger         String     @default("manual") // manual, schedule, system
  idempotencyKey  String?    @unique
  progress        Int        @default(0) // 0-100 when known
  progressDetail  Json?
  payload         Json?
  result          Json?
  error           String?
  logs            Json?      // last lines: [{ at, level, msg }]
  attempts        Int        @default(0)
  maxAttempts     Int        @default(1)
  cancelRequested Boolean    @default(false)
  retryOfId       String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([siteId, createdAt])
  @@index([status])
}

model AuditEvent {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime   @default(now())
}

/// Raised when something important changes between two crawls of the same site.
model Alert {
  id             String    @id @default(uuid())
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlRunId     String?
  crawlRun       CrawlRun? @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  type           String    // e.g. NOINDEX_ADDED, CANONICAL_CHANGED, PAGE_BROKEN
  severity       Severity  @default(MEDIUM)
  message        String
  urls           Json?
  details        Json?
  status         String    @default("open") // open, acknowledged
  deliveredTo    Json?     // channels that received it, with result
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([siteId, status])
}

/// Cache of crawler DNS verification. Keyed by family + HMAC of the IP: no raw IP or hostname is stored.
model BotIpVerification {
  key       String   @id // `${family}:${hmac(ip)}`
  family    String
  result    String   // verified | spoofed
  checkedAt DateTime @default(now())
}
