NODE_ENV=development
PORT=4000
WEB_PORT=3000
DATABASE_URL=file:./dev.db
# Para Postgres en Docker: cambia provider en schema.prisma y usa postgresql://...
REDIS_URL=redis://localhost:6379
JWT_SECRET=super-secure-production-jwt-token-replace-this-32-chars
SALT_SECRET=replace-with-a-long-random-string
DEMO_MODE=true
LOG_LEVEL=info

# Optional: comma-separated hosts the crawler may reach on private IPs (local testing only)
CRAWL_ALLOW_PRIVATE_HOSTS=
# Optional: alerts are POSTed here (generic JSON, or Slack format for hooks.slack.com URLs)
ALERT_WEBHOOK_URL=
# Encrypts stored credentials (WordPress Application Passwords). Required in production. Use a long random string.
CREDENTIALS_KEY=
