NODE_ENV=development
PORT=4000
WEB_PORT=3000
DATABASE_URL=file:./dev.db
# Para Postgres en Docker: cambia provider en schema.prisma y usa postgresql://...
REDIS_URL=redis://localhost:6379
# Key prefix in Redis (lets several environments share one Redis)
QUEUE_PREFIX=glitch
# Where uploaded logs wait for the worker (must be shared by API and worker)
UPLOAD_DIR=
# Run the job worker inside the API process (small deployments)
EMBEDDED_WORKER=false
# Retention (days) and the daily retention schedule
LOG_RETENTION_DAYS=90
JOB_RETENTION_DAYS=90
RETENTION_CRON=30 3 * * *
JWT_SECRET=super-secure-production-jwt-token-replace-this-32-chars
SALT_SECRET=replace-with-a-long-random-string
DEMO_MODE=true
LOG_LEVEL=info

# Optional: comma-separated hosts the crawler may reach on private IPs (local testing only)
CRAWL_ALLOW_PRIVATE_HOSTS=
# Optional: alerts are POSTed here (generic JSON, or Slack format for hooks.slack.com URLs)
ALERT_WEBHOOK_URL=
# Encrypts stored credentials (WordPress Application Passwords). Required in production. Use a long random string.
CREDENTIALS_KEY=
# First Owner created by `pnpm db:seed` / `pnpm demo:seed` (never commit real values)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Dashboard origin(s) allowed by CORS/CSRF, comma-separated
WEB_ORIGIN=http://localhost:3000
# Force the Secure cookie flag (defaults to true when NODE_ENV=production)
COOKIE_SECURE=
